{
  "name": "tier-list-maker",
  "productName": "Tier List Maker",
  "version": "1.0.0",
  "description": "Тир-лист с настраиваемыми зонами, шкалами оценки, весами и авто-расчётом баллов. Приложение для Windows (Electron).",
  "type": "module",
  "main": "electron/main.js",
  "author": "SweetBaget",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev-server.mjs",
    "example": "node scripts/make-example.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:core": "node --test \"test/scoring.test.mjs\"",
    "test:ui": "node --test \"test/ui.test.mjs\"",
    "dist:win": "electron-builder --win",
    "dist:win:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^24.1.3"
  },
  "build": {
    "appId": "com.sweetbaget.tierlistmaker",
    "productName": "Tier List Maker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "electron/**/*",
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tier List Maker",
      "artifactName": "TierListMaker-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TierListMaker-Portable-${version}.${ext}"
    }
  }
}
